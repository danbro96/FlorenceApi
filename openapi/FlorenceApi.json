  },
  "components": {
    "schemas": {
      "BoundingBox": {
        "required": [
          "x_min",
          "y_min",
          "x_max",
          "y_max"
        ],
        "type": "object",
        "properties": {
          "x_min": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "y_min": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "x_max": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "y_max": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CaptionDetail": {
        "enum": [
          "short",
          "detailed",
          "more_detailed"
        ]
      },
      "CaptionRequest": {
        "required": [
          "image"
        ],
        "type": "object",
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/CaptionDetail"
          },
          "image": {
            "type": "string"
          },
          "media_type": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CaptionResult": {
        "required": [
          "caption"
        ],
        "type": "object",
        "properties": {
          "caption": {
            "type": "string"
          }
        }
      },
      "DetectionRequest": {
        "required": [
          "image"
        ],
        "type": "object",
        "properties": {
          "variant": {
            "$ref": "#/components/schemas/DetectionVariant"
          },
          "image": {
            "type": "string"
          },
          "media_type": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DetectionResult": {
        "required": [
          "bboxes",
          "labels"
        ],
        "type": "object",
        "properties": {
          "bboxes": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                "type": [
                  "number",
                  "string"
                ],
                "format": "double"
              }
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DetectionVariant": {
        "enum": [
          "od",
          "dense",
          "proposal"
        ]
      },
      "GroundingRequest": {
        "required": [
          "text",
          "image"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "media_type": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ImageSize": {
        "required": [
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "width": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "height": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "OcrRegion": {
        "required": [
          "text",
          "quad",
          "box",
          "rotation",
          "confidence"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "quad": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            },
            "description": "8-element polygon as `[x1,y1,x2,y2,x3,y3,x4,y4]`, ordered TL, TR, BR, BL.\nNative shape from Florence-2; preserved verbatim for clients that need rotated polygons."
          },
          "box": {
            "description": "Axis-aligned bounding box derived from double[] OcrRegion.Quad.",
            "$ref": "#/components/schemas/BoundingBox"
          },
          "rotation": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Region rotation in degrees, derived from the top edge of double[] OcrRegion.Quad via\n`atan2(y2-y1, x2-x1)`. Range `(-180, 180]`; ~0 for upright text, ~±180 for upside-down.",
            "format": "double"
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Mean per-token probability of this region's label tokens, in `[0, 1]`.\nRelative ranking signal — not a calibrated probability.",
            "format": "double"
          }
        }
      },
      "OcrRegionsResult": {
        "required": [
          "regions",
          "image"
        ],
        "type": "object",
        "properties": {
          "regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OcrRegion"
            },
            "description": "Recognized text regions, sorted top-to-bottom and left-to-right."
          },
          "image": {
            "description": "Pixel dimensions of the image the regions are expressed in.",
            "$ref": "#/components/schemas/ImageSize"
          }
        }
      },
      "OcrRequest": {
        "required": [
          "image"
        ],
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "media_type": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OcrResult": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "OptionsResponse": {
        "required": [
          "model",
          "revision",
          "device",
          "max_image_bytes",
          "supported_formats"
        ],
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "max_image_bytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "supported_formats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SegmentationRequest": {
        "required": [
          "text",
          "image"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "image": {
            "type": "string"
