    "/ocr/regions": {
      "post": {
        "tags": [
          "OCR"
        ],
        "summary": "Extract text from an image with per-region polygons, bounding boxes, rotation, and confidence.",
        "description": "Returns a list of recognized text regions plus the image dimensions the regions are\nexpressed in. Regions are sorted top-to-bottom, left-to-right.\n\nEach region carries:\n\n- `text` — recognized text.\n- `quad` — 8-element polygon `[x1,y1,x2,y2,x3,y3,x4,y4]`, ordered TL, TR, BR, BL.\n  Native shape from Florence-2; preserved verbatim for clients that need rotated polygons.\n- `box` — axis-aligned bounding box derived from `quad` (server-side).\n- `rotation` — degrees, derived from the top edge of `quad` via `atan2(y2-y1, x2-x1)`.\n  Range `(-180, 180]`; ~0 for upright text, ~±180 for upside-down. Florence-2 does not\n  expose a rotation field natively — this is computed from the quad geometry.\n- `confidence` — mean per-token probability of the region's label tokens, in `[0, 1]`.\n  Useful as a relative ranking signal; not a calibrated probability.\n\nMaps to Florence-2 task `<OCR_WITH_REGION>`.",
        "operationId": "CreateOcrRegions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OcrRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcrRegionsResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": [ ]
          }
        ]
      }
    },
    "/segmentations": {
      "post": {
        "tags": [
          "Segmentations"
        ],
        "summary": "Segment a region described by free text.",
        "description": "Given an image and a free-text expression (in `text`), returns one or more polygons\ncovering the matching region(s) plus labels.\n\n`polygons` is `polygons[i][j]` = polygon `j` of region `i`, each polygon a flat\n`[x1, y1, x2, y2, ...]` array of pixel coordinates. A region may consist of multiple\ndisjoint polygons (e.g. an object split by occlusion).\n\nMaps to Florence-2 task `<REFERRING_EXPRESSION_SEGMENTATION>`.",
        "operationId": "CreateSegmentation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SegmentationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentationResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/problem+json": {
